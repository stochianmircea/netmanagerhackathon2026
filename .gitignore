# NM_HACKREPO — what never goes into a public repository

# secrets and keys
*.env
!.env.example
creds*
secrets*
config.php
*.key
*.pem
*.p12
*.jks
*keystore*

# databases and dumps
*.db
*.sqlite
*.sql

# backups never go into the repository
*.bak
*.orig
*.copie.*
*.inainte_*
.inainte_*
.respins_*
.nm_*

# archives
*.tar.gz
*.tgz
*.zip

# video and audio
*.mp4
*.mov
*.mkv
*.avi
*.wav

# tool droppings
*.log
*.pyc
__pycache__/
node_modules/
.DS_Store
