# NM_HACKREPO — NUME de variabile, fara valori. Fisierul asta SE publica.
# Copiaza-l in .env si completeaza acolo; .env nu intra in git (vezi .gitignore).

# modelul deschis, pe hardware propriu, prin Ollama
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=

# Meta Model API — pentru SAM si vedere, si pentru compilatorul de politici
# (--furnizor=meta). Cheia NU intra in git: .env e in .gitignore.
META_API_URL=
META_API_KEY=
META_MODEL_NAME=

# ce drum compileaza implicit politica: local (Ollama) sau meta (Meta Model API)
COMPILER_PROVIDER=

# sursa de energie (invertor) si reteaua
ENERGY_POLL_CMD=
ROUTEROS_HOST=
ROUTEROS_USER=
ROUTEROS_PASSWORD=

# cate secunde asteptam un raspuns de la model (implicit 180)
# un model de 70B care nu incape pe placa video are nevoie de mai mult
MODEL_TIMEOUT=
